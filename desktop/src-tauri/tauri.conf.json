{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiftBalance",
  "version": "0.1.0",
  "identifier": "xin.onecloud.shiftbalance",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["setup"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "payload/": "payload/" },
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese"], "displayLanguageSelector": false, "installerHooks": "installer-hooks.nsh" }
    }
  }
}
