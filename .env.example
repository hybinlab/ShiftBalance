SHIFTBALANCE_DB_URL=jdbc:postgresql://192.168.31.5:5432/shiftbalance
SHIFTBALANCE_DB_USER=shiftbalance
SHIFTBALANCE_DB_PASSWORD=replace-with-database-password

# Set both only when app_user is empty and you need to bootstrap the first login.
SHIFTBALANCE_ADMIN_USERNAME=
SHIFTBALANCE_ADMIN_PASSWORD=
SHIFTBALANCE_ADMIN_DISPLAY_NAME=排班管理员

SHIFTBALANCE_HTTP_PORT=8080
SHIFTBALANCE_CORS_ALLOWED_ORIGINS=http://localhost:8080
# Set true when HTTPS terminates at a reverse proxy in front of this stack.
SHIFTBALANCE_SESSION_COOKIE_SECURE=false
